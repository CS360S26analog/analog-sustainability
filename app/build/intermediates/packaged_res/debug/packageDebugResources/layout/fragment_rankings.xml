<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_cream_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- GOLD HEADER with podium -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_gold"
            android:orientation="vertical"
            android:paddingTop="28dp"
            android:paddingBottom="36dp"
            android:paddingStart="22dp"
            android:paddingEnd="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="CAMPUS"
                android:textColor="#CCFFFFFF"
                android:textSize="12sp"
                android:letterSpacing="0.12"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="Leader Board"
                android:textColor="@color/white"
                android:textSize="26sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp"/>

            <!-- Winner badge -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_winner_badge"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:text="🏆 Winner"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"/>

            <!-- Podium -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_marginTop="8dp">

                <!-- Rank 1 (centre, tallest) -->
                <LinearLayout
                    android:id="@+id/podium_1"
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:layout_alignParentBottom="true"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <TextView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_avatar_slate"
                        android:gravity="center"
                        android:text="AK"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold"/>

                    <LinearLayout
                        android:layout_width="90dp"
                        android:layout_height="85dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_rank_1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="1" android:textColor="@color/white" android:textSize="28sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Alex K." android:textColor="#CCFFFFFF" android:textSize="11sp"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Rank 2 (left) -->
                <LinearLayout
                    android:layout_width="78dp"
                    android:layout_height="wrap_content"
                    android:layout_toStartOf="@id/podium_1"
                    android:layout_marginEnd="6dp"
                    android:layout_alignParentBottom="true"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <TextView
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:background="@drawable/bg_avatar_teal"
                        android:gravity="center"
                        android:text="PS"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold"/>

                    <LinearLayout
                        android:layout_width="78dp"
                        android:layout_height="68dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_rank_2"
                        android:orientation="vertical"
                        android:gravity="center">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="2" android:textColor="@color/white" android:textSize="22sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Priya S." android:textColor="#CCFFFFFF" android:textSize="10sp"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Rank 3 (right) -->
                <LinearLayout
                    android:layout_width="78dp"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/podium_1"
                    android:layout_marginStart="6dp"
                    android:layout_alignParentBottom="true"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <TextView
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:background="@drawable/bg_avatar_purple"
                        android:gravity="center"
                        android:text="JL"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold"/>

                    <LinearLayout
                        android:layout_width="78dp"
                        android:layout_height="55dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_rank_3"
                        android:orientation="vertical"
                        android:gravity="center">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="3" android:textColor="@color/white" android:textSize="20sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="James L." android:textColor="#CCFFFFFF" android:textSize="10sp"/>
                    </LinearLayout>
                </LinearLayout>
            </RelativeLayout>
        </LinearLayout>

        <!-- Leaderboard rows -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="18dp"
            android:paddingBottom="16dp">

            <!-- Row 04 - YOU -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_you_row"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:text="04"
                    android:textSize="14sp"
                    android:textColor="@color/color_green_text"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_avatar_green"
                    android:gravity="center"
                    android:text="MP"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Maya P." android:textSize="15sp" android:textStyle="bold" android:textColor="@color/color_text_primary"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text=" (You)" android:textSize="13sp" android:textColor="@color/color_text_secondary"/>
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🍃 1,840 pts" android:textSize="12sp" android:textColor="@color/color_green_text"/>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+3 ▲"
                    android:textSize="13sp"
                    android:textColor="@color/color_green_text"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- Row 05 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_leaderboard_row"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center_vertical">

                <TextView android:layout_width="32dp" android:layout_height="wrap_content"
                    android:text="05" android:textSize="14sp" android:textColor="@color/color_text_secondary"/>
                <TextView android:layout_width="44dp" android:layout_height="44dp"
                    android:layout_marginStart="8dp" android:background="@drawable/bg_avatar_brown"
                    android:gravity="center" android:text="CW" android:textColor="@color/white"
                    android:textSize="13sp" android:textStyle="bold"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Chris W." android:textSize="15sp" android:textStyle="bold" android:textColor="@color/color_text_primary"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🍃 1,760 pts" android:textSize="12sp" android:textColor="@color/color_green_text"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="-1 ▼" android:textSize="13sp" android:textColor="@color/color_red_text" android:textStyle="bold"/>
            </LinearLayout>

            <!-- Row 06 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_leaderboard_row"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center_vertical">

                <TextView android:layout_width="32dp" android:layout_height="wrap_content"
                    android:text="06" android:textSize="14sp" android:textColor="@color/color_text_secondary"/>
                <TextView android:layout_width="44dp" android:layout_height="44dp"
                    android:layout_marginStart="8dp" android:background="@drawable/bg_avatar_amber"
                    android:gravity="center" android:text="SR" android:textColor="@color/white"
                    android:textSize="13sp" android:textStyle="bold"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Sofia R." android:textSize="15sp" android:textStyle="bold" android:textColor="@color/color_text_primary"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🍃 1,640 pts" android:textSize="12sp" android:textColor="@color/color_green_text"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="-2 ▼" android:textSize="13sp" android:textColor="@color/color_red_text" android:textStyle="bold"/>
            </LinearLayout>

            <!-- Row 07 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_leaderboard_row"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center_vertical">

                <TextView android:layout_width="32dp" android:layout_height="wrap_content"
                    android:text="07" android:textSize="14sp" android:textColor="@color/color_text_secondary"/>
                <TextView android:layout_width="44dp" android:layout_height="44dp"
                    android:layout_marginStart="8dp" android:background="@drawable/bg_avatar_teal"
                    android:gravity="center" android:text="OA" android:textColor="@color/white"
                    android:textSize="13sp" android:textStyle="bold"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Omar A." android:textSize="15sp" android:textStyle="bold" android:textColor="@color/color_text_primary"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🍃 1,520 pts" android:textSize="12sp" android:textColor="@color/color_green_text"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="+1 ▲" android:textSize="13sp" android:textColor="@color/color_green_text" android:textStyle="bold"/>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
