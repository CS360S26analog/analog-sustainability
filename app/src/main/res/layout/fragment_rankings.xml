<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_cream_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_gold_glow"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="24dp"
            android:paddingEnd="22dp"
            android:paddingBottom="30dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:letterSpacing="0.14"
                android:text="CAMPUS"
                android:textColor="#CCFFFFFF"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="2dp"
                android:text="Leader Board"
                android:textColor="@color/white"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_winner_badge"
                android:paddingStart="18dp"
                android:paddingTop="5dp"
                android:paddingEnd="18dp"
                android:paddingBottom="5dp"
                android:text="🏆 Live Rankings"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="194dp"
                android:layout_marginTop="8dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_marginStart="18dp"
                    android:layout_marginTop="14dp"
                    android:text="✦"
                    android:textColor="#EFFFFFFF"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_marginTop="20dp"
                    android:layout_marginEnd="42dp"
                    android:text="✦"
                    android:textColor="#EFFFFFFF"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:text="✦"
                    android:textColor="#CCFFFFFF"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_marginStart="66dp"
                    android:layout_marginTop="56dp"
                    android:text="✧"
                    android:textColor="#DDFFFFFF"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_marginTop="64dp"
                    android:layout_marginEnd="74dp"
                    android:text="✧"
                    android:textColor="#DDFFFFFF"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="150dp"
                    android:layout_height="110dp"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true"
                    android:layout_marginBottom="34dp"
                    android:background="@drawable/bg_podium_glow" />

                <LinearLayout
                    android:id="@+id/podium_1"
                    android:layout_width="96dp"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:layout_marginBottom="4dp"
                        android:background="@drawable/bg_winner_badge"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="You"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <FrameLayout
                        android:layout_width="60dp"
                        android:layout_height="70dp"
                        android:clipChildren="false"
                        android:clipToPadding="false">

                        <TextView
                            android:id="@+id/text_rank_1_initials"
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:background="@drawable/bg_avatar_green"
                            android:gravity="center"
                            android:text="ME"
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_gravity="bottom|center_horizontal"
                            android:translationY="12dp"
                            android:contentDescription="First place medal"
                            android:src="@drawable/ic_medal_gold" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="96dp"
                        android:layout_height="88dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_rank_1_3d"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp">

                        <TextView
                            android:id="@+id/text_rank_1_name"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_podium_name_plaque"
                            android:elevation="4dp"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-black"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:maxWidth="92dp"
                            android:minWidth="72dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="Waiting"
                            android:textColor="#4A2A12"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/text_rank_1_points"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="82dp"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:layout_marginEnd="8dp"
                    android:layout_toStartOf="@id/podium_1"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="52dp"
                        android:layout_height="60dp"
                        android:clipChildren="false"
                        android:clipToPadding="false">

                        <TextView
                            android:id="@+id/text_rank_2_initials"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:background="@drawable/bg_avatar_teal"
                            android:gravity="center"
                            android:text="HA"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="top|end"
                            android:translationX="10dp"
                            android:translationY="-6dp"
                            android:contentDescription="Second place medal"
                            android:src="@drawable/ic_medal_silver" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="82dp"
                        android:layout_height="70dp"
                        android:layout_marginTop="7dp"
                        android:background="@drawable/bg_rank_2_3d"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingStart="3dp"
                        android:paddingEnd="3dp">

                        <TextView
                            android:id="@+id/text_rank_2_name"
                            android:layout_width="wrap_content"
                            android:layout_height="30dp"
                            android:background="@drawable/bg_podium_name_plaque"
                            android:elevation="4dp"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-black"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:maxWidth="78dp"
                            android:minWidth="62dp"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:text="Waiting"
                            android:textColor="#4A2A12"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/text_rank_2_points"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="82dp"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:layout_marginStart="8dp"
                    android:layout_toEndOf="@id/podium_1"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="50dp"
                        android:layout_height="58dp"
                        android:clipChildren="false"
                        android:clipToPadding="false">

                        <TextView
                            android:id="@+id/text_rank_3_initials"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:background="@drawable/bg_avatar_purple"
                            android:gravity="center"
                            android:text="TE"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="31dp"
                            android:layout_height="31dp"
                            android:layout_gravity="top|end"
                            android:translationX="10dp"
                            android:translationY="-6dp"
                            android:contentDescription="Third place medal"
                            android:src="@drawable/ic_medal_bronze" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="82dp"
                        android:layout_height="58dp"
                        android:layout_marginTop="7dp"
                        android:background="@drawable/bg_rank_3_3d"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingStart="3dp"
                        android:paddingEnd="3dp">

                        <TextView
                            android:id="@+id/text_rank_3_name"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:background="@drawable/bg_podium_name_plaque"
                            android:elevation="4dp"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-black"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:maxWidth="74dp"
                            android:minWidth="58dp"
                            android:paddingStart="9dp"
                            android:paddingEnd="9dp"
                            android:text="Waiting"
                            android:textColor="#4A2A12"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/text_rank_3_points"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
            </RelativeLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/card_nemesis_watch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_nemesis_card"
            android:clickable="true"
            android:elevation="4dp"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:gravity="center"
                    android:text="🛡️"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/text_nemesis_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:letterSpacing="0.08"
                    android:text="NEMESIS WATCH"
                    android:textColor="@color/color_green_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/text_nemesis_live_chip"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_live_chip"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="● LIVE"
                    android:textColor="@color/color_green_text"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_nemesis_main"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_close_gap_panel"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="76dp"
                        android:layout_height="86dp"
                        android:clipChildren="false"
                        android:clipToPadding="false">

                        <TextView
                            android:id="@+id/text_nemesis_initials"
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:layout_gravity="bottom|center_horizontal"
                            android:background="@drawable/bg_avatar_teal"
                            android:gravity="center"
                            android:text="HA"
                            android:textColor="@color/white"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="34dp"
                            android:layout_height="30dp"
                            android:layout_gravity="top|center_horizontal"
                            android:translationX="-18dp"
                            android:translationY="3dp"
                            android:rotation="-18"
                            android:contentDescription="Left horn"
                            android:src="@drawable/ic_nemesis_horn_left" />

                        <ImageView
                            android:layout_width="34dp"
                            android:layout_height="30dp"
                            android:layout_gravity="top|center_horizontal"
                            android:translationX="18dp"
                            android:translationY="3dp"
                            android:rotation="18"
                            android:contentDescription="Right horn"
                            android:src="@drawable/ic_nemesis_horn_right" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/text_nemesis_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Haroon"
                            android:textColor="@color/color_text_primary"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/text_nemesis_rank"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_live_chip"
                            android:gravity="center"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="RANK #2"
                            android:textColor="@color/color_text_secondary"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/text_nemesis_gap"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="202 pts"
                            android:textColor="@color/color_red_text"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/text_nemesis_gap_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="lead gap"
                            android:textColor="@color/color_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/text_nemesis_lower_name"
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:text="Haroon"
                        android:textColor="@color/color_text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <ProgressBar
                        android:id="@+id/progress_nemesis_gap"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp"
                        android:layout_height="8dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@drawable/progress_nemesis_gap" />

                    <TextView
                        android:id="@+id/text_nemesis_higher_name"
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="You"
                        android:textColor="@color/color_text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/text_nemesis_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text=""
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btn_close_gap"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_button_amber"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingStart="22dp"
                        android:paddingEnd="22dp"
                        android:text="🛡 Defend Rank"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_close_gap_suggestions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_close_gap_panel"
                android:orientation="vertical"
                android:padding="14dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="RECOMMENDED TO CATCH UP"
                    android:textColor="@color/color_green_text"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/text_suggestion_one"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="🚲 Log activities to unlock suggestions"
                    android:textColor="@color/color_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/text_suggestion_two"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="🥗 Verified logs can help you climb"
                    android:textColor="@color/color_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/text_suggestion_three"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="👟 Keep your streak alive"
                    android:textColor="@color/color_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_nemesis_log_activity"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_button_amber"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="Log Activity"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.1"
                android:text="LIVE LEADERBOARD"
                android:textColor="@color/color_green_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_leaderboard_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Loading leaderboard..."
                android:textColor="@color/color_text_secondary"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/leaderboard_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>