<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_cream_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_green"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="28dp"
            android:paddingEnd="22dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Staff Panel"
                android:textColor="#CCFFFFFF"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Campus Overview"
                android:textColor="@color/white"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Live campus sustainability stats"
                android:textColor="#CCFFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="18dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- Section label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LIVE CAMPUS STATS"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/color_text_secondary"
                android:letterSpacing="0.08"
                android:layout_marginBottom="10dp"/>

            <!-- Stats row 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <!-- CO2 card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/white">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="14dp"
                        android:gravity="center_vertical">
                        <View
                            android:layout_width="4dp"
                            android:layout_height="match_parent"
                            android:background="@color/color_green_header"
                            android:layout_marginEnd="12dp"/>
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="CO₂ Saved"
                                android:textSize="11sp"
                                android:textColor="@color/color_text_secondary"
                                android:textAllCaps="true"
                                android:letterSpacing="0.05"/>
                            <TextView
                                android:id="@+id/tv_staff_total_co2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Loading…"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/color_green_header"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Active students card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/white">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="14dp"
                        android:gravity="center_vertical">
                        <View
                            android:layout_width="4dp"
                            android:layout_height="match_parent"
                            android:background="@color/color_green_header"
                            android:layout_marginEnd="12dp"/>
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Active Students"
                                android:textSize="11sp"
                                android:textColor="@color/color_text_secondary"
                                android:textAllCaps="true"
                                android:letterSpacing="0.05"/>
                            <TextView
                                android:id="@+id/tv_staff_active_users"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Loading…"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/color_green_header"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- Stats row 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp">

                <!-- Challenges card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/white">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="14dp"
                        android:gravity="center_vertical">
                        <View
                            android:layout_width="4dp"
                            android:layout_height="match_parent"
                            android:background="@color/color_amber"
                            android:layout_marginEnd="12dp"/>
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Challenges"
                                android:textSize="11sp"
                                android:textColor="@color/color_text_secondary"
                                android:textAllCaps="true"
                                android:letterSpacing="0.05"/>
                            <TextView
                                android:id="@+id/tv_staff_active_challenges"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Loading…"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/color_amber"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Flagged card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/white">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="14dp"
                        android:gravity="center_vertical">
                        <View
                            android:id="@+id/flagged_border"
                            android:layout_width="4dp"
                            android:layout_height="match_parent"
                            android:background="#C0392B"
                            android:layout_marginEnd="12dp"/>
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Flagged"
                                android:textSize="11sp"
                                android:textColor="@color/color_text_secondary"
                                android:textAllCaps="true"
                                android:letterSpacing="0.05"/>
                            <TextView
                                android:id="@+id/tv_staff_flagged_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Loading…"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="#C0392B"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- Quick Actions label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="QUICK ACTIONS"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/color_text_secondary"
                android:letterSpacing="0.08"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:id="@+id/btn_quick_manage"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_header_green"
                android:gravity="center"
                android:text="⚙️  Create / Manage Challenges"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/btn_quick_tips"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_card_amber"
                android:gravity="center"
                android:text="💡  Publish a Sustainability Tip"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/btn_quick_reports"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_card_forest"
                android:gravity="center"
                android:text="📊  View Reports &amp; Flagged"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/btn_quick_logs"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_card_forest"
                android:gravity="center"
                android:text="📋  Manage Activity Logs"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="20dp"
                android:clickable="true"
                android:focusable="true"/>

            <!-- Recent Activity label -->
            <!-- Pending Reviews -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PENDING REVIEWS"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/color_text_secondary"
                android:letterSpacing="0.08"
                android:layout_marginBottom="10dp"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/tv_staff_pending_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Loading…"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/color_green_header"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="submissions awaiting community review"
                            android:textSize="12sp"
                            android:textColor="@color/color_text_secondary"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/btn_go_review"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_header_green"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:text="Review →"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Top Activities This Week -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TOP ACTIVITIES THIS WEEK"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/color_text_secondary"
                android:letterSpacing="0.08"
                android:layout_marginBottom="10dp"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">
                <LinearLayout
                    android:id="@+id/ll_top_activities"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Loading…"
                        android:textSize="13sp"
                        android:textColor="@color/color_text_secondary"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>