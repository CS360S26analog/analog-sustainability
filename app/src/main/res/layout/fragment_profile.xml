<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_profile_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- GREEN HEADER (avatar overlaps) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="180dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:background="@drawable/bg_header_green"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="20dp"
                android:gravity="top">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🍃"
                    android:textSize="20sp"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Campus"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <!-- Notification icons -->
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <FrameLayout android:layout_width="38dp" android:layout_height="38dp" android:layout_marginEnd="8dp">
                        <TextView android:layout_width="38dp" android:layout_height="38dp"
                            android:background="@drawable/bg_card_white" android:gravity="center"
                            android:text="👤+" android:textSize="12sp"/>
                        <View android:layout_width="10dp" android:layout_height="10dp"
                            android:layout_gravity="top|end" android:background="@drawable/bg_notification_dot"/>
                    </FrameLayout>
                    <FrameLayout android:layout_width="38dp" android:layout_height="38dp">
                        <TextView android:layout_width="38dp" android:layout_height="38dp"
                            android:background="@drawable/bg_card_white" android:gravity="center"
                            android:text="🔔" android:textSize="14sp"/>
                        <View android:layout_width="10dp" android:layout_height="10dp"
                            android:layout_gravity="top|end" android:background="@drawable/bg_notification_dot"/>
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Avatar circle (centred, overlapping) -->
            <FrameLayout
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_gravity="bottom|center_horizontal">

                <TextView
                    android:id="@+id/tv_avatar_initials"
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:background="@drawable/bg_avatar_circle"
                    android:gravity="center"
                    android:text="MP"
                    android:textColor="@color/white"
                    android:textSize="32sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/bg_notification_dot"
                    android:gravity="center"
                    android:text="⚙"
                    android:textColor="@color/white"
                    android:textSize="12sp"/>
            </FrameLayout>
        </FrameLayout>

        <!-- Name & badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="10dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/tv_display_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Maya P."
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/color_text_primary"/>
            <TextView
                android:id="@+id/tv_university"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="LUMS"
                android:textSize="13sp"
                android:textColor="@color/color_text_secondary"
                android:drawablePadding="4dp"/>

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="6dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_eco_badge"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="Eco Warrior"
                    android:textSize="13sp"
                    android:textColor="@color/color_eco_badge_text"/>
                <TextView android:id="@+id/tv_points_badge" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text=" • 1,840 pts" android:textSize="14sp" android:textColor="@color/color_text_primary" android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Stats cards -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <!-- CO2 card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="20dp">
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:layout_width="32dp" android:layout_height="32dp"
                            android:background="@drawable/bg_badge_green"
                            android:gravity="center" android:text="☁" android:textSize="14sp" android:textColor="@color/color_green_text"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="Total CO2 Saved"
                            android:textSize="14sp" android:textColor="@color/color_text_secondary"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="8dp">
                        <TextView android:id="@+id/tv_co2_value" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="2.4" android:textSize="36sp" android:textStyle="bold" android:textColor="@color/color_text_primary"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text=" kg" android:textSize="20sp" android:textColor="@color/color_text_primary" android:layout_marginStart="4dp"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Streak + Challenges row -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="16dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/white">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="18dp">
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center_vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="🔥 " android:textSize="14sp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Days Streak" android:textSize="13sp" android:textColor="@color/color_text_secondary"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="6dp">
                            <TextView android:id="@+id/tv_streak_value" android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="14" android:textSize="28sp" android:textStyle="bold" android:textColor="@color/color_text_primary"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text=" days" android:textSize="14sp" android:textColor="@color/color_text_secondary"/>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/white">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="18dp">
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center_vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="✅ " android:textSize="14sp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Challenges" android:textSize="13sp" android:textColor="@color/color_text_secondary"/>
                        </LinearLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="12" android:textSize="28sp" android:textStyle="bold"
                            android:textColor="@color/color_text_primary" android:layout_marginTop="6dp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- Achievements -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="12dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Achievements"
                    android:textSize="18sp" android:textStyle="bold" android:textColor="@color/color_text_primary"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="View all" android:textSize="13sp" android:textColor="@color/color_green_text"
                    android:id="@+id/tv_view_all"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="24dp">

                <!-- Seedling -->
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <TextView android:layout_width="62dp" android:layout_height="62dp"
                        android:background="@drawable/bg_badge_green"
                        android:gravity="center" android:text="⚡" android:textSize="24sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="SEEDLING" android:textSize="10sp" android:textStyle="bold"
                        android:textColor="@color/color_green_text" android:layout_marginTop="6dp"/>
                </LinearLayout>

                <!-- Commuter -->
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <TextView android:layout_width="62dp" android:layout_height="62dp"
                        android:background="@drawable/bg_badge_amber"
                        android:gravity="center" android:text="🚲" android:textSize="24sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="COMMUTER" android:textSize="10sp" android:textStyle="bold"
                        android:textColor="@color/color_amber_text" android:layout_marginTop="6dp"/>
                </LinearLayout>

                <!-- Sorter -->
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <TextView android:layout_width="62dp" android:layout_height="62dp"
                        android:background="@drawable/bg_badge_blue"
                        android:gravity="center" android:text="♻️" android:textSize="24sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="SORTER" android:textSize="10sp" android:textStyle="bold"
                        android:textColor="#3A6A9A" android:layout_marginTop="6dp"/>
                </LinearLayout>

                <!-- Locked -->
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <TextView android:layout_width="62dp" android:layout_height="62dp"
                        android:background="@drawable/bg_badge_locked"
                        android:gravity="center" android:text="🔒" android:textSize="22sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="LOCKED" android:textSize="10sp" android:textStyle="bold"
                        android:textColor="@color/color_text_secondary" android:layout_marginTop="6dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Rewards -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="12dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Available Rewards"
                    android:textSize="18sp" android:textStyle="bold" android:textColor="@color/color_text_primary"/>
            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:id="@+id/rewards_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp"/>

            </androidx.cardview.widget.CardView>

            <!-- Account section -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Account" android:textSize="18sp" android:textStyle="bold"
                android:textColor="@color/color_text_primary" android:layout_marginBottom="10dp"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Account Settings -->
                    <LinearLayout android:id="@+id/row_account" android:layout_width="match_parent"
                        android:layout_height="56dp" android:orientation="horizontal"
                        android:padding="16dp" android:gravity="center_vertical"
                        android:clickable="true" android:focusable="true">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="👤 " android:textSize="16sp"/>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="Account Settings"
                            android:textSize="15sp" android:textColor="@color/color_text_primary"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="›" android:textSize="20sp" android:textColor="@color/color_text_secondary"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/color_divider" android:layout_marginStart="16dp"/>

                    <!-- Privacy -->
                    <LinearLayout android:id="@+id/row_privacy" android:layout_width="match_parent"
                        android:layout_height="56dp" android:orientation="horizontal"
                        android:padding="16dp" android:gravity="center_vertical"
                        android:clickable="true" android:focusable="true">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="🔒 " android:textSize="16sp"/>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="Privacy"
                            android:textSize="15sp" android:textColor="@color/color_text_primary"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="›" android:textSize="20sp" android:textColor="@color/color_text_secondary"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/color_divider" android:layout_marginStart="16dp"/>

                    <!-- Notifications -->
                    <LinearLayout android:id="@+id/row_notifications" android:layout_width="match_parent"
                        android:layout_height="56dp" android:orientation="horizontal"
                        android:padding="16dp" android:gravity="center_vertical"
                        android:clickable="true" android:focusable="true">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="🔔 " android:textSize="16sp"/>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="Notifications"
                            android:textSize="15sp" android:textColor="@color/color_text_primary"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="›" android:textSize="20sp" android:textColor="@color/color_text_secondary"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/color_divider" android:layout_marginStart="16dp"/>

                    <!-- Help & Support -->
                    <LinearLayout android:id="@+id/row_help" android:layout_width="match_parent"
                        android:layout_height="56dp" android:orientation="horizontal"
                        android:padding="16dp" android:gravity="center_vertical"
                        android:clickable="true" android:focusable="true">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="❓ " android:textSize="16sp"/>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="Help &amp; Support"
                            android:textSize="15sp" android:textColor="@color/color_text_primary"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="›" android:textSize="20sp" android:textColor="@color/color_text_secondary"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/color_divider" android:layout_marginStart="16dp"/>

                    <!-- Log Out -->
                    <LinearLayout
                        android:id="@+id/row_logout"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🚪 "
                            android:textSize="16sp"/>
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Log Out"
                            android:textSize="15sp"
                            android:textColor="#D32F2F"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textSize="20sp"
                            android:textColor="@color/color_text_secondary"/>
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>