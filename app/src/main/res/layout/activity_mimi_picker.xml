<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_cream_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tv_mimi_picker_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pick your LUMS cat"
            android:textColor="@color/color_text_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_mimi_picker_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Choose the LUMS campus cat who will cheer you on while you log sustainable actions."
            android:textColor="@color/color_text_secondary"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/card_mimi_cat_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_card_white"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="18dp">

            <app.rive.runtime.kotlin.RiveAnimationView
                android:id="@+id/rive_mimi_cat_1"
                android:layout_width="match_parent"
                android:layout_height="170dp"
                app:riveAutoPlay="true"
                app:riveFit="CONTAIN"
                app:riveResource="@raw/mimi_cat_1" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Mimi"
                android:textColor="@color/color_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_choose_mimi_cat_1"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_button_green"
                android:gravity="center"
                android:text="Choose Mimi"
                android:textColor="@color/white"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/card_mimi_cat_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_white"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="18dp">

            <app.rive.runtime.kotlin.RiveAnimationView
                android:id="@+id/rive_mimi_cat_2"
                android:layout_width="match_parent"
                android:layout_height="170dp"
                app:riveAutoPlay="true"
                app:riveFit="CONTAIN"
                app:riveResource="@raw/mimi_cat_2" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Momo"
                android:textColor="@color/color_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_choose_mimi_cat_2"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_button_green"
                android:gravity="center"
                android:text="Choose Momo"
                android:textColor="@color/white"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/card_mimi_cat_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_card_white"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="18dp">

            <app.rive.runtime.kotlin.RiveAnimationView
                android:id="@+id/rive_mimi_cat_3"
                android:layout_width="match_parent"
                android:layout_height="170dp"
                app:riveAutoPlay="true"
                app:riveFit="CONTAIN"
                app:riveResource="@raw/mimi_cat_3" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Misha"
                android:textColor="@color/color_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_choose_mimi_cat_3"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_button_green"
                android:gravity="center"
                android:text="Choose Misha"
                android:textColor="@color/white"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>