<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:top="8dp">
        <shape>
            <corners android:radius="8dp" />
            <solid android:color="#224728" />
        </shape>
    </item>

    <item android:bottom="7dp">
        <shape>
            <corners android:radius="8dp" />
            <gradient
                android:startColor="#4B7D55"
                android:centerColor="#315F39"
                android:endColor="#214A2B"
                android:angle="270" />
        </shape>
    </item>

    <item android:top="1dp" android:left="4dp" android:right="4dp" android:bottom="64dp">
        <shape>
            <corners android:radius="6dp" />
            <solid android:color="#66FFFFFF" />
        </shape>
    </item>

</layer-list>