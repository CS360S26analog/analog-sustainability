<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- soft shadow -->
    <item android:top="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="7dp" />
            <solid android:color="#5E3418" />
        </shape>
    </item>

    <!-- dark wood outer frame -->
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="7dp" />
            <gradient
                android:angle="0"
                android:startColor="#8C4D26"
                android:centerColor="#6F3A1C"
                android:endColor="#8C4D26" />
            <stroke
                android:width="1dp"
                android:color="#5C2F16" />
        </shape>
    </item>

    <!-- gold plaque -->
    <item
        android:left="3dp"
        android:top="3dp"
        android:right="3dp"
        android:bottom="5dp">
        <shape android:shape="rectangle">
            <corners android:radius="5dp" />
            <gradient
                android:angle="90"
                android:startColor="#F7E3A0"
                android:centerColor="#D4A94F"
                android:endColor="#F0D98E" />
            <stroke
                android:width="1dp"
                android:color="#B07C2A" />
        </shape>
    </item>

    <!-- inner bevel line -->
    <item
        android:left="5dp"
        android:top="5dp"
        android:right="5dp"
        android:bottom="7dp">
        <shape android:shape="rectangle">
            <corners android:radius="4dp" />
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="0.8dp"
                android:color="#F9E9B8" />
        </shape>
    </item>

</layer-list>